{
  "name": "@local/wxmp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "公众号文章工作台：在 DSH 里写稿、排版、生成封面、建草稿并发布到微信公众号。模型侧提供 wxmp 工具，界面侧提供三栏工作台（文章列表 / 预览 / 发布流水线）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "ui-backend.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "skills"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wodaimnd/wxmp.git"
  },
  "homepage": "https://github.com/wodaimnd/wxmp#readme",
  "bugs": {
    "url": "https://github.com/wodaimnd/wxmp/issues"
  },
  "author": "Kewei Chen <wodaimnd@users.noreply.github.com>",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin"
  ]
}
